    <!-- Execution Logic Control Pipeline Engines -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let activeCategoryId = <?php echo $active_cat_id; ?>;
            const searchField = document.getElementById('liveSearchInput');
            const sortSelection = document.getElementById('sortEngineSelect');
            const targetGrid = document.getElementById('asyncContainer');
            const globalLoader = document.getElementById('catalogLoader');
            const blankState = document.getElementById('emptyCatalogState');

            // Bind Event Listeners to Category Filter Components
            document.querySelectorAll('.category-filter-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    document.querySelectorAll('.category-filter-btn').forEach(b => {
                        b.classList.remove('active-gold-filter');
                        b.classList.add('text-gray-400');
                    });
                    e.currentTarget.classList.add('active-gold-filter');
                    e.currentTarget.classList.remove('text-gray-400');
                    
                    activeCategoryId = e.currentTarget.getAttribute('data-cat-id');
                    triggerAsynchronousSync();
                });
            });

            // Input Debounce Pipeline Execution Layer for Optimized Database Interactions
            let runtimeDebounceTimer;
            searchField.addEventListener('input', () => {
                clearTimeout(runtimeDebounceTimer);
                runtimeDebounceTimer = setTimeout(triggerAsynchronousSync, 350);
            });

            sortSelection.addEventListener('change', triggerAsynchronousSync);

            // Fetch and Process Database State Operations Asynchronously via AJAX Content Stream Engine
            function triggerAsynchronousSync() {
                globalLoader.classList.remove('hidden');
                targetGrid.innerHTML = '';
                blankState.classList.add('hidden');

                const queryParameters = new URLSearchParams({
                    action: 'filter',
                    query: searchField.value,
                    category: activeCategoryId,
                    sort: sortSelection.value
                });

                fetch(`../controllers/ProductController.php?${queryParameters.toString()}`)
                    .then(res => res.json())
                    .then(payload => {
                        globalLoader.classList.add('hidden');
                        if(payload.status === 'success' && payload.count > 0) {
                            renderCatalogCards(payload.data);
                        } else {
                            blankState.classList.remove('hidden');
                        }
                    })
                    .catch(err => {
                        globalLoader.classList.add('hidden');
                        console.error('Core catalog sync pipeline encounter error:', err);
                    });
            }

            // High-Fidelity Client-side Component Component Compilation Render Routine
            function renderCatalogCards(items) {
                let htmlBuffer = '';
                items.forEach(item => {
                    const fallbackImg = item.primary_img ? item.primary_img : 'https://images.unsplash.com/photo-1605721911519-3dfeb3be25e7?q=80&w=600&auto=format&fit=crop';
                    const formattedPrice = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(item.base_price);
                    
                    htmlBuffer += `
                        <div class="luxury-glass group overflow-hidden transition-all duration-500 hover:shadow-[0_20px_40px_rgba(212,175,55,0.08)]">
                            <div class="relative overflow-hidden aspect-[4/5] bg-neutral-900">
                                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" style="background-image: url('${fallbackImg}');"></div>
                                <div class="absolute inset-0 bg-gradient-to-t from-luxBlack via-transparent to-transparent opacity-80"></div>
                                <span class="absolute bottom-4 left-4 text-[10px] tracking-widest text-gray-400 font-mono uppercase bg-luxBlack/60 px-2 py-0.5 border border-white/5">${item.sku}</span>
                            </div>
                            <div class="p-6">
                                <span class="text-[11px] uppercase tracking-[0.2em] text-luxGold block">${item.cat_name}</span>
                                <h4 class="font-serif text-xl mt-1 mb-4 text-white group-hover:text-luxGold transition-colors">${item.title_en}</h4>
                                <div class="flex justify-between items-center pt-4 border-t border-white/5">
                                    <span class="font-serif text-lg text-gray-300">${formattedPrice}</span>
                                    <a href="https://wa.me/91XXXXXXXXXX?text=I%20am%20inquiring%20about%20the%20${encodeURIComponent(item.title_en)}%20(SKU:%20${item.sku})" target="_blank" class="text-xs uppercase tracking-widest text-luxGold flex items-center gap-2 hover:underline">
                                        Inquire <i class="fab fa-whatsapp"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    `;
                });
                targetGrid.innerHTML = htmlBuffer;
            }

            // Initial Bootstrap Catalog Load Trigger invocation
            triggerAsynchronousSync();
        });
    </script>
